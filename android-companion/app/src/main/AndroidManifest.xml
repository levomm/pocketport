<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />\n\n    <queries>\n        <package android:name="com.termux" />\n    </queries>
    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_pocketport"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_pocketport"
        android:supportsRtl="true"
        android:theme="@style/Theme.PocketPort"
        android:usesCleartextTraffic="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
